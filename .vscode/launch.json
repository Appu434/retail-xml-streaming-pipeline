{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Local Demo (Trigger Once)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/streaming_job.py",
      "console": "integratedTerminal",
      "env": {
        "SPARK_LOCAL_IP": "127.0.0.1"
      },
      "args": [
        "--env", "local",
        "--trigger", "once"
      ]
    }
  ]
}
